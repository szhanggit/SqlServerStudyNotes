        {
            "name": "[concat(parameters('factoryName'), '/setting_tenant_configuration')]",
            "type": "Microsoft.DataFactory/factories/pipelines",
            "apiVersion": "2018-06-01",
            "properties": {
                "activities": [
                    {
                        "name": "setting_tenant_configuration",
                        "type": "Script",
                        "dependsOn": [],
                        "policy": {
                            "timeout": "0.12:00:00",
                            "retry": 0,
                            "retryIntervalInSeconds": 30,
                            "secureOutput": false,
                            "secureInput": false
                        },
                        "userProperties": [],
                        "linkedServiceName": {
                            "referenceName": "txcloud_d",
                            "type": "LinkedServiceReference",
                            "parameters": {
                                "database_name": {
                                    "value": "@pipeline().parameters.master_database_name",
                                    "type": "Expression"
                                }
                            }
                        },
                        "typeProperties": {
                            "scripts": [
                                {
                                    "type": "NonQuery",
                                    "text": {
                                        "value": "  IF EXISTS(SELECT 1 FROM dbo.tb_tc_tenant_config tttc with(nolock) WHERE tttc.tenant_id = @{pipeline().parameters.tenant_id} AND tttc.configtype = N'@{pipeline().parameters.configtype}' AND tttc.configname = N'@{pipeline().parameters.configname}' AND tttc.version = N'@{pipeline().parameters.version}')\r\n  BEGIN\r\n\t\tUPDATE tttc SET tttc.[value] = N'@{pipeline().parameters.value}',tttc.[comment] = N'@{pipeline().parameters.comment}' from dbo.tb_tc_tenant_config tttc \r\n    WHERE tttc.tenant_id = @{pipeline().parameters.tenant_id} AND tttc.configtype = N'@{pipeline().parameters.configtype}' AND tttc.configname = N'@{pipeline().parameters.configname}' AND tttc.version = N'@{pipeline().parameters.version}';\r\n  END\r\n  ELSE\r\n  BEGIN\r\n\tINSERT INTO dbo.tb_tc_tenant_config\r\n  (tenant_id,configtype,configname,version,[value],comment,creation_time)\r\n  VALUES(@{pipeline().parameters.tenant_id},\r\n  N'@{pipeline().parameters.configtype}',\r\n  N'@{pipeline().parameters.configname}',\r\n  N'@{pipeline().parameters.version}',\r\n  N'@{pipeline().parameters.value}', \r\n  N'@{pipeline().parameters.comment}',\r\n  getutcdate());\r\n  END",
                                        "type": "Expression"
                                    }
                                }
                            ],
                            "scriptBlockExecutionTimeout": "02:00:00"
                        }
                    }
                ],
                "policy": {
                    "elapsedTimeMetric": {},
                    "cancelAfter": {}
                },
                "parameters": {
                    "master_database_name": {
                        "type": "string"
                    },
                    "tenant_id": {
                        "type": "int"
                    },
                    "configtype": {
                        "type": "string"
                    },
                    "configname": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "comment": {
                        "type": "string"
                    }
                },
                "folder": {
                    "name": "Tenant Administrator"
                },
                "annotations": [],
                "lastPublishTime": "2023-04-18T03:35:25Z"
            },
            "dependsOn": [
                "[concat(variables('factoryId'), '/linkedServices/txcloud_d')]"
            ]
        },

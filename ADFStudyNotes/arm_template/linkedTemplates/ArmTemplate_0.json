                                    "text": "BEGIN TRAN\r\nBEGIN TRY\r\n    update sync.tb_s_synchronization_history set remarks = 'aaa' where sync_history_id = 18\r\n    update sync.tb_s_synchronization_history set remarks = 'bbb' where sync_history_id = 19\r\n    update sync.tb_s_synchronization_history set remarks = 1/0 where sync_history_id = 20\r\n       \r\n    COMMIT TRAN;\r\nEND TRY\r\nBEGIN CATCH\r\n    ROLLBACK TRAN;\r\n\r\n    SET @ErrorMessage = ERROR_MESSAGE();\r\n    THROW;\r\nEND CATCH"
                                }
